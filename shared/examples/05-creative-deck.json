{
  "version": "1.0",
  "meta": {
    "title": "Lumen 思考工具",
    "aspectRatio": "auto"
  },
  "theme": {
    "mode": "dark",
    "colors": {
      "bg": "#0a0e1a",
      "fg": "#f8fafc",
      "primary": "#a78bfa",
      "accent": "#22d3ee",
      "muted": "#64748b"
    },
    "fonts": { "heading": "Inter", "body": "Inter" },
    "radius": "lg"
  },
  "variables": {},
  "slides": [
    {
      "id": "",
      "layout": "quote",
      "transition": "fade",
      "background": {
        "type": "gradient",
        "from": "#0a0e1a",
        "to": "#1e1b4b",
        "angle": 135
      },
      "utilities": ["hxs-bg-grid"],
      "blocks": [
        { "type": "heading", "level": 2, "text": "好的工具，应该消失。", "magicId": "tagline" },
        { "type": "text", "text": "—— Lumen 设计哲学", "align": "center" }
      ]
    },
    {
      "id": "",
      "layout": "hero",
      "transition": "magic",
      "background": {
        "type": "image",
        "url": "https://picsum.photos/seed/dark-cosmos-purple/1280/720",
        "opacity": 0.45
      },
      "utilities": ["hxs-bg-radial"],
      "blocks": [
        { "type": "badge", "text": "2026 春季", "tone": "accent" },
        { "type": "heading", "level": 1, "text": "Lumen", "utilities": ["hxs-text-gradient", "hxs-text-glow"], "magicId": "tagline" },
        { "type": "text", "text": "一个让思考自然发生的写作空间。", "align": "center" },
        { "type": "button", "label": "开始使用", "variant": "primary", "onClick": { "action": "next" }, "utilities": ["hxs-shadow-glow"] }
      ]
    },
    {
      "id": "",
      "layout": "two-column",
      "transition": "fade",
      "blocks": [
        { "type": "heading", "level": 2, "text": "工业级写作面板", "column": "left" },
        { "type": "text", "text": "深空蓝主色 + 等宽字体监测面板，让长文写作不再焦虑。", "column": "left" },
        { "type": "image", "url": "https://picsum.photos/seed/code-editor-night/800/600", "alt": "Lumen 工作台", "fit": "cover", "column": "right", "utilities": ["hxs-shadow-lg"] }
      ]
    },
    {
      "id": "",
      "layout": "bullet-list",
      "transition": "slide-up",
      "blocks": [
        { "type": "heading", "level": 2, "text": "三件值得在意的事" },
        {
          "type": "card",
          "title": "结构感",
          "subtitle": "不强迫层级",
          "children": [
            { "type": "text", "text": "无序的笔记自动归类，但你随时可以打破它。" }
          ],
          "utilities": ["hxs-frost", "hxs-shadow-lg", "hxs-tilted"]
        },
        {
          "type": "card",
          "title": "节奏感",
          "subtitle": "尊重思考的速度",
          "children": [
            { "type": "text", "text": "AI 不抢话，等你停笔时再补一句。" }
          ],
          "utilities": ["hxs-frost", "hxs-shadow-lg", "hxs-rotate-1"]
        },
        {
          "type": "card",
          "title": "颗粒感",
          "subtitle": "细节决定质感",
          "children": [
            { "type": "text", "text": "字距、行间距、底色—每一个像素都被推敲。" }
          ],
          "utilities": ["hxs-frost", "hxs-shadow-lg", "hxs-rotate-neg-1"]
        }
      ]
    },
    {
      "id": "",
      "layout": "free",
      "transition": "zoom",
      "background": {
        "type": "gradient",
        "from": "#0a0e1a",
        "to": "#1e1b4b",
        "angle": 135
      },
      "utilities": ["hxs-bg-noise"],
      "blocks": [
        {
          "type": "heading",
          "level": 1,
          "text": "0.18s",
          "utilities": ["hxs-text-glow", "hxs-text-gradient"],
          "position": { "xPct": 8, "yPct": 28 }
        },
        {
          "type": "text",
          "text": "击键到屏幕的延迟",
          "position": { "xPct": 8, "yPct": 65 }
        },
        {
          "type": "badge",
          "text": "比业界快 4 倍",
          "tone": "accent",
          "position": { "xPct": 60, "yPct": 22 },
          "utilities": ["hxs-tilted"]
        },
        {
          "type": "icon",
          "name": "Zap",
          "size": 56,
          "tone": "accent",
          "position": { "xPct": 78, "yPct": 60 },
          "utilities": ["hxs-animate-float"]
        }
      ]
    },
    {
      "id": "",
      "layout": "cta",
      "transition": "fade",
      "background": {
        "type": "gradient",
        "from": "#1e1b4b",
        "to": "#312e81",
        "angle": 180
      },
      "utilities": ["hxs-bg-radial"],
      "blocks": [
        { "type": "heading", "level": 2, "text": "试一次，再决定。" },
        { "type": "text", "text": "30 天免费，无需信用卡。", "align": "center" },
        { "type": "button", "label": "下载", "variant": "primary", "onClick": { "action": "openLink", "url": "https://example.com" }, "utilities": ["hxs-shadow-glow"] },
        { "type": "button", "label": "看文档", "variant": "outline", "onClick": { "action": "openLink", "url": "https://example.com/docs" } }
      ]
    }
  ]
}
